{
    "private": true,
    "name": "preact-limeapp",
    "version": "0.2.26",
    "description": "Limeapp webUI and app",
    "license": "GNU",
    "author": "Marcos Gutierrez <gmarcos@altermundi.net>",
    "scripts": {
        "start": "vite",
        "start:production": "npm run -s serve",
        "start:development": "npm run -s dev",
        "build": "vite build",
        "prebuild:production": "lingui extract",
        "build:production": "vite build",
        "serve": "vite preview",
        "dev": "vite",
        "lint": "tsc && eslint . && prettier --ignore-path .gitignore --check \"**/*.+(js|jsx|ts|tsx|json|css|sass|less)\"",
        "lint:fix": "tsc && eslint . --fix && prettier --ignore-path .gitignore --write \"**/*.+(js|jsx|ts|tsx|json|css|sass|less)\"",
        "translations:extract": "lingui extract --clean",
        "translations:compile": "lingui compile",
        "cz": "git-cz",
        "release": "standard-version",
        "test": "jest",
        "clear-jest": "jest --clearCache",
        "create-plugin": "node ./devTools/plugins create",
        "prepare": "husky"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@babel/preset-env": "^7.29.7",
        "@babel/preset-typescript": "^7.29.7",
        "@lingui/babel-plugin-lingui-macro": "^5.9.5",
        "@lingui/babel-preset-react": "^2.9.2",
        "@lingui/cli": "^5.9.5",
        "@lingui/detect-locale": "^5.9.5",
        "@lingui/macro": "^5.9.5",
        "@lingui/vite-plugin": "^5.9.5",
        "@preact/preset-vite": "^2.10.6",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/preact": "^3.2.4",
        "@testing-library/user-event": "^14.6.7",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/jest": "^30.0.0",
        "@types/leaflet": "^1.9.22",
        "@typescript-eslint/eslint-plugin": "^8.70.0",
        "@typescript-eslint/parser": "^8.70.0",
        "autoprefixer": "^10.4.21",
        "babel-jest": "^30.5.2",
        "babel-plugin-jsx-pragmatic": "^1.0.2",
        "babel-plugin-macros": "^3.1.0",
        "babel-preset-preact": "^2.0.0",
        "core-js": "^3.50.0",
        "cssnano": "^7.1.1",
        "dotenv": "^18.0.0",
        "eslint": "^10.10.0",
        "eslint-config-preact": "^2.0.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jest": "^29.16.6",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-testing-library": "^7.16.2",
        "husky": "^9.1.7",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "jest-extended": "^7.0.0",
        "jest-fetch-mock": "^4.2.0",
        "jest-localstorage-mock": "^2.4.26",
        "jest-preset-preact": "^4.1.1",
        "less": "^4.9.1",
        "lint-staged": "^16.4.0",
        "postcss": "^8.5.28",
        "preact-render-to-string": "^6.7.0",
        "prettier": "^3.9.8",
        "standard-version": "^9.5.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.70.0",
        "vite": "^6.4.1",
        "wait-for-expect": "^4.0.0",
        "xhr-mock": "^2.5.1"
    },
    "dependencies": {
        "@lingui/core": "^5.9.5",
        "@lingui/react": "^5.9.5",
        "@tanstack/react-query": "^5.103.1",
        "@tanstack/react-query-devtools": "^5.103.1",
        "compressorjs": "^1.3.0",
        "history": "^5.3.0",
        "leaflet": "^1.9.4",
        "preact": "^10.29.8",
        "preact-router": "^4.1.2",
        "react-hook-form": "^7.88.0",
        "react-leaflet": "^4.2.1",
        "react-redux": "^9.3.0",
        "react-router-redux": "^4.0.8",
        "react-use": "^17.6.1",
        "redux": "^5.0.1",
        "redux-observable": "3.0.0-rc.3",
        "rxjs": "^7.8.2",
        "simple-color-scale": "^1.0.1",
        "timeago.js": "^4.0.2"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{css,less,json}": "prettier --write"
    },
    "engines": {
        "node": ">=20"
    }
}
